GEMINI_API_KEY=your_key_here
# Faster default model (recommended):
GEMINI_MODEL=gemini-2.0-flash-lite
# Speed: compact prompt (default) | full spec prompt
PROMPT_MODE=compact
# Truncate long message bodies sent to the model (chars per message)
MAX_MESSAGE_BODY_CHARS=600
# Default analysis skips drafting for speed (draft later via /api/drafts)
INCLUDE_DRAFTS_BY_DEFAULT=0
# Use full original prompt from prompt.py
# PROMPT_MODE=full
